FROM php:8.4-fpm-alpine

# Swapped MySQL dependencies for PostgreSQL (postgresql-client and postgresql-dev)
RUN apk add --no-cache \
    zip \
    unzip \
    curl \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    oniguruma-dev \
    libxml2-dev \
    postgresql-client \
    postgresql-dev

RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo_pgsql mbstring exif pcntl bcmath gd xml opcache

# OPcache: o código é imutável dentro da imagem, então não precisa revalidar.
RUN { \
    echo "opcache.enable=1"; \
    echo "opcache.memory_consumption=128"; \
    echo "opcache.max_accelerated_files=20000"; \
    echo "opcache.validate_timestamps=0"; \
    } > /usr/local/etc/php/conf.d/opcache.ini

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www

COPY composer.json composer.lock ./

RUN composer install --no-dev --optimize-autoloader --no-scripts --prefer-dist

# We copy the rest of the backend directory contents into the working directory
COPY . .

# Regenera o classmap agora que app/ existe na imagem (o install acima roda
# antes do COPY, então as classes da aplicação ficavam fora do classmap).
RUN composer dump-autoload --optimize --no-dev --no-scripts

RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache

USER www-data
EXPOSE 9000
CMD ["php-fpm"]
